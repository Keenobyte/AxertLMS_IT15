@model IEnumerable<AxertLMS.Models.Enrollment>
@using System.Text.Json

@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var chartData = ViewBag.ChartData as List<double>;
    double overallAverage = chartData != null && chartData.Any() ? Math.Round(chartData.Average(), 2) : 0;

    var labelsJson = JsonSerializer.Serialize(ViewBag.ChartLabels);
    var dataJson = JsonSerializer.Serialize(ViewBag.ChartData);
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    /* Strict HCI Dark Mode Palette */
    :root {
        --bg-main: #1A1A1A;
        --bg-card: #121212;
        --text-primary: #FFFFFF;
        --text-secondary: #9CA3AF;
        --border-subtle: #2D3748;
        --navy-light: #0B1F3A;
        --navy-dark: #020C1B;
        /* Status Colors */
        --danger: #EF4444;
        --warning: #F59E0B;
        --success: #10B981;
    }

    /* Core Layout */
    .dashboard-wrapper {
        display: flex;
        flex-direction: column;
        gap: 24px;
        color: var(--text-primary);
    }

    .header-section h1 {
        margin: 0;
        font-size: 2rem;
        color: var(--text-primary);
    }

    .header-section p {
        color: var(--text-secondary);
        margin-top: 5px;
    }

    /* Zone 1: Quick Stats */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
    }

    .stat-card {
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 20px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.2);
        border-left: 5px solid var(--text-secondary);
    }

        .stat-card.warning {
            border-left-color: var(--warning);
        }

        .stat-card.danger {
            border-left-color: var(--danger);
        }

        .stat-card.success {
            border-left-color: var(--success);
        }

    .stat-icon {
        font-size: 2rem;
        background: rgba(255,255,255,0.05);
        padding: 15px;
        border-radius: 12px;
    }

    .stat-info h3 {
        margin: 0;
        font-size: 2rem;
        line-height: 1;
        color: var(--text-primary) !important;
    }

    .stat-info p {
        margin: 5px 0 0 0;
        color: var(--text-secondary);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* Main Grid Split */
    .main-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
        align-items: start;
    }

    /* Panels */
    .panel {
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.2);
    }

    .panel-header {
        border-bottom: 1px solid var(--border-subtle);
        padding-bottom: 15px;
        margin-bottom: 20px;
    }

        .panel-header h2 {
            margin: 0;
            font-size: 1.2rem;
            color: var(--text-primary);
        }

    /* To-Do List - Added Scroll */
    .todo-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
        max-height: 350px;
        overflow-y: auto;
        padding-right: 10px;
    }

        .todo-list::-webkit-scrollbar {
            width: 8px;
        }

        .todo-list::-webkit-scrollbar-track {
            background: var(--bg-main);
            border-radius: 4px;
        }

        .todo-list::-webkit-scrollbar-thumb {
            background: var(--border-subtle);
            border-radius: 4px;
        }

            .todo-list::-webkit-scrollbar-thumb:hover {
                background: var(--text-secondary);
            }

    .todo-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 15px;
        background: rgba(255,255,255,0.03);
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        transition: transform 0.2s, border-color 0.2s;
    }

        .todo-item:hover {
            transform: translateX(5px);
            border-color: var(--text-secondary);
        }

    .todo-title {
        font-weight: bold;
        font-size: 1.1rem;
        margin-bottom: 5px;
        color: var(--text-primary);
    }

    .todo-subject {
        color: var(--text-secondary);
        font-size: 0.9rem;
    }

    .badge {
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: bold;
    }

        .badge.due {
            background: rgba(245, 158, 11, 0.15);
            color: var(--warning);
        }

        .badge.overdue {
            background: rgba(239, 68, 68, 0.15);
            color: var(--danger);
        }

    .btn-action {
        background: var(--border-subtle);
        color: var(--text-primary);
        text-decoration: none;
        padding: 8px 15px;
        border-radius: 6px;
        font-size: 0.9rem;
        margin-top: 10px;
        display: inline-block;
        transition: background 0.2s;
    }

        .btn-action:hover {
            background: var(--text-secondary);
            color: var(--bg-main);
        }

    /* Courses Grid */
    .course-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 20px;
        margin-top: 24px;
    }

    .course-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid var(--border-subtle);
        border-radius: 10px;
        padding: 20px;
        text-align: center;
        text-decoration: none;
        color: var(--text-primary);
        transition: all 0.2s;
    }

        .course-card:hover {
            background: var(--bg-main);
            border-color: var(--text-secondary);
            transform: translateY(-5px);
        }

    .course-icon {
        font-size: 2.5rem;
        margin-bottom: 15px;
    }
</style>

<div class="dashboard-wrapper">
    <div class="header-section">
        <h1>Welcome back, @ViewBag.StudentName! 👋</h1>
        <p>Here is your academic overview for today.</p>
    </div>

    <div class="stats-grid">
        <div class="stat-card warning">
            <div class="stat-icon">📅</div>
            <div class="stat-info">
                <h3 style="color: var(--warning) !important;">@ViewBag.DueThisWeekCount</h3>
                <p>Due This Week</p>
            </div>
        </div>

        <div class="stat-card @(ViewBag.OverdueCount > 0 ? "danger" : "success")">
            <div class="stat-icon">@(ViewBag.OverdueCount > 0 ? "⚠️" : "✅")</div>
            <div class="stat-info">
                <h3 style="color: @(ViewBag.OverdueCount > 0 ? "var(--danger)" : "var(--success)") !important;">@ViewBag.OverdueCount</h3>
                <p>@(ViewBag.OverdueCount > 0 ? "Overdue Tasks" : "All Caught Up!")</p>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">📈</div>
            <div class="stat-info">
                <h3>@overallAverage%</h3>
                <p>Overall Average</p>
            </div>
        </div>
    </div>

    <div class="main-grid">

        <div>
            <div class="panel">
                <div class="panel-header">
                    <h2>🎯 Up Next (To-Do)</h2>
                </div>

                @if (ViewBag.ToDoList != null && ViewBag.ToDoList.Count > 0)
                {
                    <div class="todo-list">
                        @foreach (var item in ViewBag.ToDoList)
                        {
                            <div class="todo-item">
                                <div>
                                    <div class="todo-title">@item.Title</div>
                                    <div class="todo-subject">@item.Subject</div>
                                </div>
                                <div style="text-align: right;">
                                    @if (item.IsOverdue)
                                    {
                                        <div class="badge overdue">Overdue: @item.DueDate.ToString("MMM dd, yyyy")</div>
                                    }
                                    else
                                    {
                                        <div class="badge due">Due: @item.DueDate.ToString("MMM dd, yyyy")</div>
                                    }
                                    <br />
                                    <a href="/Student/SubmitAssignment/@item.AssignmentId" class="btn-action">View Details</a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="text-align: center; padding: 30px; color: var(--text-secondary);">
                        <div style="font-size: 3rem; margin-bottom: 10px;">🎮</div>
                        <p>No urgent tasks right now! Take a break.</p>
                    </div>
                }
            </div>

            <div class="course-grid">
                @foreach (var enrollment in Model)
                {
                    <a href="/Student/ClassDetails/@enrollment.classroom_id" class="course-card">
                        <div class="course-icon">📚</div>
                        <h3 style="font-size: 1.1rem; margin: 0 0 5px 0;">@enrollment.Classroom!.Subject!.subject_name</h3>
                        <p style="color: var(--text-secondary); font-size: 0.85rem; margin:0;">
                            Prof. @enrollment.Classroom!.Teacher!.User!.l_name
                        </p>
                    </a>
                }
            </div>
        </div>

        <div class="panel">
            <div class="panel-header">
                <h2>📊 Subject Performance</h2>
            </div>
            <div style="position: relative; height: 300px; width: 100%;">
                <canvas id="performanceChart"></canvas>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const labels = @Html.Raw(labelsJson);
        const dataPoints = @Html.Raw(dataJson);

        const ctx = document.getElementById('performanceChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Average Grade',
                    data: dataPoints,
                    /* Updated to match Strict HCI Palette */
                    backgroundColor: 'rgba(156, 163, 175, 0.8)', /* var(--text-secondary) */
                    borderColor: '#9CA3AF',
                    borderWidth: 1,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,
                        grid: { color: 'rgba(255,255,255,0.05)' },
                        ticks: { color: '#9CA3AF' } /* var(--text-secondary) */
                    },
                    x: {
                        grid: { display: false },
                        ticks: { color: '#9CA3AF' }
                    }
                }
            }
        });
    });
</script>