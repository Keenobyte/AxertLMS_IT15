@model List<AxertLMS.Models.Assignment>
@{
    ViewData["Title"] = "My Assignments";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var submittedIds = ViewBag.SubmittedIds as List<int> ?? new List<int>();
    var now = DateTime.Now;

    // Pre-categorize for the view
    var missing = Model.Where(a => a.due_date < now && !submittedIds.Contains(a.assignment_id)).ToList();
    var todo = Model.Where(a => a.due_date >= now && !submittedIds.Contains(a.assignment_id)).ToList();
    var done = Model.Where(a => submittedIds.Contains(a.assignment_id)).ToList();
}

<style>
    .page-hero {
        background: linear-gradient(135deg, #121212 0%, #1A1A1A 100%);
        border: 1px solid #2D3748;
        border-left: 5px solid #0B1F3A;
        padding: 30px;
        border-radius: 12px;
        margin-bottom: 30px;
    }

    .tabs {
        display: flex;
        gap: 15px;
        margin-bottom: 25px;
        border-bottom: 2px solid #2D3748;
        padding-bottom: 10px;
    }

    .tab-btn {
        background: transparent;
        color: #9CA3AF;
        border: none;
        font-size: 1.1rem;
        font-weight: bold;
        padding: 10px 20px;
        cursor: pointer;
        border-radius: 6px;
        transition: all 0.2s;
    }

        .tab-btn.active {
            background: #0B1F3A;
            color: #FFFFFF;
        }

        .tab-btn:hover:not(.active) {
            background: rgba(45, 55, 72, 0.5);
            color: #E2E8F0;
        }

    .task-container {
        display: none;
    }

        .task-container.active {
            display: block;
        }

    .task-card {
        background: #121212;
        border: 1px solid #2D3748;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: transform 0.2s;
    }

        .task-card:hover {
            transform: translateX(5px);
            border-color: #0B1F3A;
        }

    .subject-badge {
        font-size: 0.8rem;
        background: #2D3748;
        padding: 4px 8px;
        border-radius: 4px;
        color: #E2E8F0;
        margin-bottom: 8px;
        display: inline-block;
    }

    .task-title {
        font-size: 1.15rem;
        font-weight: bold;
        color: #FFFFFF;
        margin: 0 0 5px 0;
    }

    .task-meta {
        font-size: 0.9rem;
        color: #9CA3AF;
    }

    .meta-danger {
        color: #EF4444;
        font-weight: bold;
    }

    .btn-action {
        background: #0B1F3A;
        color: #FFFFFF;
        padding: 8px 20px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: bold;
    }

        .btn-action:hover {
            background: #112d52;
            color: #FFF;
        }

    .status-done {
        color: #10B981;
        background: rgba(16, 185, 129, 0.1);
        padding: 8px 16px;
        border-radius: 20px;
        border: 1px solid #10B981;
        font-weight: bold;
    }
</style>

<div class="page-hero">
    <h1 style="color: white; margin: 0;">Activities</h1>
    <p style="color: #9CA3AF; margin: 5px 0 0 0;">Manage your pending and completed coursework.</p>
</div>

<div class="tabs">
    <button class="tab-btn active" onclick="showTab('todo', this)">To Do (@todo.Count)</button>
    <button class="tab-btn" onclick="showTab('missing', this)">Missing (@missing.Count)</button>
    <button class="tab-btn" onclick="showTab('done', this)">Done (@done.Count)</button>
</div>

<div id="todo" class="task-container active">
    @if (!todo.Any())
    {
        <p style="color: #9CA3AF; text-align: center; padding: 30px;">You're all caught up on upcoming tasks!</p>
    }
    @foreach (var task in todo)
    {
        <div class="task-card">
            <div>
                <span class="subject-badge">@task.Classroom?.Subject?.subject_name</span>
                <h3 class="task-title">@task.title</h3>
                <div class="task-meta">Due: @task.due_date.ToString("ddd, MMM dd - h:mm tt")</div>
            </div>
            <a href="/Student/SubmitAssignment/@task.assignment_id" class="btn-action">Submit</a>
        </div>
    }
</div>

<div id="missing" class="task-container">
    @if (!missing.Any())
    {
        <p style="color: #10B981; text-align: center; padding: 30px;">🎉 Awesome! You have no missing assignments.</p>
    }
    @foreach (var task in missing)
    {
        <div class="task-card" style="border-left: 4px solid #EF4444;">
            <div>
                <span class="subject-badge">@task.Classroom?.Subject?.subject_name</span>
                <h3 class="task-title">@task.title</h3>
                <div class="task-meta meta-danger">Past Due: @task.due_date.ToString("MMM dd, yyyy")</div>
            </div>
            <a href="/Student/SubmitAssignment/@task.assignment_id" class="btn-action">Submit Late</a>
        </div>
    }
</div>

<div id="done" class="task-container">
    @if (!done.Any())
    {
        <p style="color: #9CA3AF; text-align: center; padding: 30px;">No assignments completed yet.</p>
    }
    @foreach (var task in done)
    {
        <div class="task-card" style="opacity: 0.8;">
            <div>
                <span class="subject-badge">@task.Classroom?.Subject?.subject_name</span>
                <h3 class="task-title">@task.title</h3>
            </div>
            <div class="status-done">✓ Turned In</div>
        </div>
    }
</div>

<script>
    function showTab(tabId, element) {
        // Hide all containers
        document.querySelectorAll('.task-container').forEach(c => c.classList.remove('active'));
        // Remove active class from all buttons
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));

        // Show selected tab and highlight button
        document.getElementById(tabId).classList.add('active');
        element.classList.add('active');
    }
</script>