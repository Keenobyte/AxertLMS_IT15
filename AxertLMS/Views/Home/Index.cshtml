@{
    Layout = null;
    ViewData["Title"] = "Axert University | Learning Management System";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="AxertLMS is Axert University's learning management system for students and faculty." />
    <meta name="robots" content="index,follow" />
    <title>@ViewData["Title"]</title>
    <style>
        :root {
            color-scheme: dark;
            font-family: "Segoe UI", system-ui, sans-serif;
            background: #111318;
            color: #f3f4f6;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
            box-sizing: border-box;
        }

        main {
            width: min(100%, 760px);
            padding: clamp(28px, 6vw, 64px);
            border: 1px solid #303642;
            border-radius: 20px;
            background: #191c22;
            box-sizing: border-box;
        }

        h1 {
            margin: 0 0 12px;
            font-size: clamp(2rem, 5vw, 3.25rem);
        }

        p {
            color: #b6becb;
            line-height: 1.7;
        }

        nav {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            margin-top: 32px;
        }

        a {
            color: #9dc2ff;
        }

        .primary-link {
            display: inline-block;
            padding: 12px 20px;
            border-radius: 8px;
            background: #174a87;
            color: white;
            text-decoration: none;
            font-weight: 600;
        }

        footer {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 44px;
            border-top: 1px solid #303642;
            padding-top: 20px;
        }
    </style>
</head>
<body>
    <main>
        <h1>Axert University</h1>
        <p><strong>AxertLMS</strong> is the university's learning management system for student registration, courses, assignments, submissions, and academic records.</p>
        <p>Students and faculty can access the learning portal using their AxertLMS account.</p>
        <nav aria-label="Public information">
            <a class="primary-link" href="@Url.Action("Login", "Account")">Go to sign in</a>
        </nav>
        <footer>
            <a href="@Url.Action("Privacy", "Home")">Privacy Policy</a>
            <a href="@Url.Action("Terms", "Home")">Terms of Service</a>
            <a href="mailto:kurtcandrejo@gmail.com">Contact</a>
        </footer>
    </main>
</body>
</html>
