@model AxertLMS.Models.Assignment

@{
    ViewData["Title"] = Model.title + " Details";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var gradingQueue = ViewBag.GradingQueue as IEnumerable<dynamic> ?? new List<dynamic>();

    int totalStudents = gradingQueue.Count();
    int submittedCount = gradingQueue.Count(q => q.Submission != null);
    int missingCount = totalStudents - submittedCount;
    int gradedCount = gradingQueue.Count(q => q.Grade != null);
}

<style>
    .header-panel {
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 30px;
    }

    .status-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 20px;
    }

    .status-box {
        padding: 15px;
        border-radius: 8px;
        background: var(--bg-main);
        border: 1px solid var(--border-subtle);
        text-align: center;
    }

        .status-box h3 {
            margin: 0;
            font-size: 2rem;
            color: var(--text-primary);
        }

        .status-box p {
            margin: 5px 0 0 0;
            color: var(--text-secondary);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        background: var(--bg-card);
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--border-subtle);
    }

        .data-table th, .data-table td {
            padding: 15px 20px;
            text-align: left;
            border-bottom: 1px solid var(--border-subtle);
            vertical-align: middle;
        }

        .data-table th {
            background: var(--bg-main);
            color: var(--text-secondary);
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .data-table tr:last-child td {
            border-bottom: none;
        }

        .data-table tbody tr:hover {
            background: rgba(255, 255, 255, 0.03);
        }

    .row-needs-grading {
        background: rgba(59, 130, 246, 0.05);
    }

    .status-text {
        font-size: 0.9rem;
    }

    .text-missing {
        color: var(--text-secondary);
    }

    .text-needs-grading {
        color: #F59E0B;
        font-style: italic;
        font-weight: 600;
    }

    .text-graded {
        color: #10B981;
        font-style: italic;
    }

    .grade-input {
        width: 80px;
        background: var(--bg-main);
        border: 1px solid var(--border-subtle);
        color: var(--text-primary);
        padding: 8px 12px;
        border-radius: 6px;
        transition: border-color 0.2s;
    }

        .grade-input:focus {
            outline: none;
            border-color: #3B82F6;
        }

    .feedback-input {
        width: 100%;
        background: var(--bg-main);
        border: 1px solid var(--border-subtle);
        color: var(--text-primary);
        padding: 8px 12px;
        border-radius: 6px;
        transition: border-color 0.2s;
    }

        .feedback-input:focus {
            outline: none;
            border-color: #3B82F6;
        }

    .btn-action {
        background: #3B82F6;
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 500;
        transition: background 0.2s;
    }

        .btn-action:hover {
            background: #2563EB;
        }

    .btn-update {
        background: transparent;
        color: var(--text-secondary);
        border: 1px solid var(--border-subtle);
    }

        .btn-update:hover {
            color: var(--text-primary);
            border-color: var(--text-primary);
        }

    .badge-plagiarism {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        margin-top: 6px;
    }

    .plag-unchecked {
        background: rgba(255, 255, 255, 0.05);
        color: var(--text-secondary);
    }

    .plag-safe {
        background: rgba(16, 185, 129, 0.1);
        color: #10B981;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }

    .plag-warning {
        background: rgba(245, 158, 11, 0.1);
        color: #F59E0B;
        border: 1px solid rgba(245, 158, 11, 0.2);
    }

    .plag-danger {
        background: rgba(239, 68, 68, 0.1);
        color: #EF4444;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .btn-plag-scan {
        background: transparent;
        color: var(--text-secondary);
        border: 1px solid var(--border-subtle);
        font-size: 0.75rem;
        padding: 2px 6px;
        border-radius: 4px;
        cursor: pointer;
        margin-top: 4px;
        display: inline-flex;
        align-items: center;
        gap: 3px;
        transition: all 0.2s;
    }

        .btn-plag-scan:hover {
            color: #3B82F6;
            border-color: #3B82F6;
            background: rgba(59, 130, 246, 0.05);
        }
</style>

<div style="margin-bottom: 20px;">
    <a href="/Teacher/ClassroomDetails/@Model.classroom_id" style="color: var(--text-secondary); text-decoration: none;">← Back to Classroom</a>
</div>

@if (TempData["Success"] != null)
{
    <div style="margin-bottom: 20px; padding: 12px 15px; border: 1px solid rgba(16,185,129,0.25); background: rgba(16,185,129,0.08); color: #10B981; border-radius: 8px;">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div style="margin-bottom: 20px; padding: 12px 15px; border: 1px solid rgba(239,68,68,0.25); background: rgba(239,68,68,0.08); color: #EF4444; border-radius: 8px;">
        @TempData["Error"]
    </div>
}

<div class="header-panel">
    <h1 style="margin: 0 0 5px 0; font-size: 1.8rem;">@Model.title</h1>
    <div style="color: var(--text-secondary);">
        Due: <span style="color: #F59E0B; font-weight: bold;">@Model.due_date.ToString("MMM dd, yyyy - hh:mm tt")</span>
    </div>

    <div class="status-grid">
        <div class="status-box">
            <h3>@submittedCount</h3>
            <p>Submitted</p>
        </div>
        <div class="status-box">
            <h3 style="color: #EF4444;">@missingCount</h3>
            <p>Missing</p>
        </div>
        <div class="status-box">
            <h3 style="color: #10B981;">@gradedCount</h3>
            <p>Graded</p>
        </div>
    </div>
</div>

<h2 style="font-size: 1.2rem; margin-bottom: 15px; color: var(--text-primary);">Student Submissions</h2>

<table class="data-table">
    <thead>
        <tr>
            <th>Student Name</th>
            <th>Status</th>
            <th>Submission File</th>
            <th>Score</th>
            <th>Feedback</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (!gradingQueue.Any())
        {
            <tr>
                <td colspan="6" style="text-align: center; color: var(--text-secondary); padding: 40px; font-style: italic;">
                    No students currently enrolled in this class.
                </td>
            </tr>
        }

        @foreach (var item in gradingQueue)
        {
            var student = item.Student as AxertLMS.Models.Student;
            var submission = item.Submission as AxertLMS.Models.Submission;
            var grade = item.Grade as AxertLMS.Models.Grade; var rowClass = (submission != null && grade == null) ? "row-needs-grading" : "";

            <tr class="@rowClass">
                <td>
                    <div style="font-weight: 600; color: var(--text-primary);">@student?.User?.l_name, @student?.User?.f_name</div>
                    <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 2px;">ID: @student?.student_number</div>
                </td>

                <td>
                    @if (submission == null)
                    {
                        <span class="status-text text-missing">Missing</span>
                    }
                    else if (grade == null)
                    {
                        <span class="status-text text-needs-grading">Needs Grading</span>
                    }
                    else
                    {
                        <span class="status-text text-graded">Graded</span>
                    }
                </td>

                <td>
                    @if (submission != null)
                    {
                        if (!string.IsNullOrEmpty(submission.file_path))
                        {
                            <a href="@submission.file_path" target="_blank" style="color: #3B82F6; text-decoration: none; font-weight: 500;">📄 View Work</a>
                        }
                        else
                        {
                            <span style="color: var(--text-secondary); font-style: italic;">Text Entry</span>
                        }
                        <div style="color: var(--text-secondary); font-size: 0.8rem; margin-top: 4px;">@submission.submitted_at.ToString("MMM dd, hh:mm tt")</div>

                        <div>
                            @{
                                string badgeClass = "plag-unchecked";
                                string badgeText = "Plagiarism: Unchecked";

                                if (submission.PlagiarismPercentage > 0)
                                {
                                    badgeText = $"Plagiarism: {submission.PlagiarismPercentage}% Overlap";
                                    if (submission.PlagiarismPercentage > 30) badgeClass = "plag-danger";
                                    else if (submission.PlagiarismPercentage > 15) badgeClass = "plag-warning";
                                    else badgeClass = "plag-safe";
                                }
                            }
                            <span id="badge-@submission.submission_id" class="badge-plagiarism @badgeClass">
                                @badgeText
                            </span>
                            <br />
                            <button type="button" class="btn-plag-scan" onclick="runPlagiarismScan(@submission.submission_id)">
                                🔄 Run Scan
                            </button>
                        </div>
                    }
                    else
                    {
                        <span style="color: var(--text-secondary); font-style: italic;">No file</span>
                    }
                </td>

                @if (submission != null)
                {
                    <form action="/Teacher/SaveGrade" method="post" style="display: contents;">
                        <input type="hidden" name="submission_id" value="@submission.submission_id" />
                        <input type="hidden" name="assignment_id" value="@Model.assignment_id" />

                        <td>
                            <input type="number" step="0.01" name="score" class="grade-input" required
                                   placeholder="/100"
                                   value="@(grade != null ? grade.score.ToString("0.##") : "")" />
                        </td>

                        <td>
                            <input type="text" name="feedback" class="feedback-input" placeholder="Add comments here..."
                                   value="@(grade != null ? grade.feedback : "")" />
                        </td>

                        <td>
                            <button type="submit" class="btn-action @(grade != null ? "btn-update" : "")">
                                @(grade != null ? "Update" : "Save Grade")
                            </button>
                        </td>
                    </form>
                }
                else
                {
                    <td colspan="3" style="text-align: center; color: var(--text-secondary); font-style: italic; background: rgba(0,0,0,0.1);">
                        Awaiting student submission
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<script>
    async function runPlagiarismScan(submissionId) {
        const badge = document.getElementById(`badge-${submissionId}`);
        badge.className = "badge-plagiarism plag-unchecked";
        badge.innerText = "Analyzing text slices...";

        try {
            const response = await fetch(`/api/plagiarism/check?submissionId=${submissionId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });

            if (!response.ok) throw new Error('API Execution Error');

            const data = await response.json();

            if (data.plagiarism_percentage > 30) {
                badge.className = "badge-plagiarism plag-danger";
            } else if (data.plagiarism_percentage > 15) {
                badge.className = "badge-plagiarism plag-warning";
            } else {
                badge.className = "badge-plagiarism plag-safe";
            }

            badge.innerText = `Plagiarism: ${data.plagiarism_percentage}% Overlap`;

        } catch (error) {
            console.error(error);
            badge.className = "badge-plagiarism plag-danger";
            badge.innerText = "Scan Failed";
        }
    }
</script>