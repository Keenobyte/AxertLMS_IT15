@model AxertLMS.Models.Quiz

<h2>@Model.title</h2>

<p>
    Difficulty:
    <strong>@Model.difficulty</strong>
</p>

<hr />

@foreach (var q in Model.Questions!)
{
    <div style="margin-bottom:25px;">

        <h4>@q.question_text</h4>

        @if (q.question_type == "Multiple Choice")
        {
            <p>A. @q.option_a</p>
            <p>B. @q.option_b</p>
            <p>C. @q.option_c</p>
            <p>D. @q.option_d</p>
        }

        <p>
            <strong>
                Answer:
                @q.correct_answer
            </strong>
        </p>
    </div>
}