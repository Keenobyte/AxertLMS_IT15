@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    ViewData["Title"] = "Student Enrollment";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Enrollment - AXERT LMS</title>
    <style>
            :root {
                --bg-main: #1A1A1A;
                --bg-card: #121212;
                --bg-card-light: #1E1E1E;
                --text-primary: #FFFFFF;
                --text-secondary: #9CA3AF;
                --border-subtle: #2D3748;
                --navy-light: #0B1F3A;
                --navy-dark: #020C1B;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                background: var(--bg-main);
                color: var(--text-primary);
                font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            }

            .page {
                min-height: 100vh;
                display: grid;
                grid-template-columns: 1fr 1fr;
            }

            .left {
                padding: 60px;
                background: var(--bg-card);
                border-right: 1px solid var(--border-subtle);
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            /* Restored Brand Component */
            .brand {
                display: flex;
                gap: 20px;
                align-items: center;
                padding: 25px;
                border: 1px solid var(--border-subtle);
                border-left: 4px solid var(--navy-light);
                border-radius: 12px;
                background: var(--bg-main);
                max-width: 620px;
                width: 100%;
                margin: 0 auto 40px auto;
            }

                .brand img {
                    width: 75px;
                    height: auto;
                    display: block;
                }

            .brand-title {
                font-size: 1.8rem;
                font-weight: 800;
                color: var(--text-primary);
            }

            .brand-subtitle {
                color: var(--text-secondary);
                margin-top: 5px;
                font-size: 0.95rem;
            }

            /* Announcement Component */
            .announcement-section {
                max-width: 620px;
                width: 100%;
                margin: 0 auto;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .announcement-title {
                color: var(--text-secondary);
                text-transform: uppercase;
                font-size: 0.85rem;
                letter-spacing: 1px;
                margin-bottom: 15px;
                font-weight: 600;
            }

            .announcement-card {
                background: var(--bg-card-light);
                padding: 35px;
                border-radius: 8px;
                border: 1px solid var(--border-subtle);
                box-shadow: 0 8px 16px rgba(0,0,0,0.2);
            }

                .announcement-card p {
                    color: var(--text-secondary);
                    line-height: 1.6;
                    font-size: 0.95rem;
                    margin-bottom: 12px;
                }

                .announcement-card strong {
                    color: var(--text-primary);
                }

                .announcement-card ul {
                    padding-left: 20px;
                    margin-top: 10px;
                    margin-bottom: 15px;
                }

                .announcement-card li {
                    color: var(--text-secondary);
                    line-height: 1.6;
                    font-size: 0.95rem;
                    margin-bottom: 8px;
                }

            .right {
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px;
            }

            .card {
                width: 100%;
                max-width: 470px;
                background: var(--bg-card);
                border: 1px solid var(--border-subtle);
                border-radius: 16px;
                padding: 42px;
                box-shadow: 0 12px 30px rgba(0,0,0,0.4);
            }

            h1 {
                text-align: center;
                margin: 0;
                font-size: 1.8rem;
            }

            .subtitle {
                text-align: center;
                color: var(--text-secondary);
                font-size: 0.9rem;
                line-height: 1.5;
                margin-bottom: 25px;
            }

            .notice {
                padding: 16px;
                border-left: 4px solid var(--navy-light);
                border-radius: 0 8px 8px 0;
                background: rgba(255,255,255,0.025);
                margin-bottom: 24px;
            }

                .notice strong {
                    display: block;
                    margin-bottom: 6px;
                }

                .notice span {
                    color: var(--text-secondary);
                    font-size: 0.86rem;
                    line-height: 1.5;
                }

            .google-btn {
                display: block;
                width: 100%;
                padding: 14px;
                border-radius: 9px;
                font-size: 0.95rem;
                font-weight: 700;
                text-align: center;
                text-decoration: none;
                background: #FFFFFF;
                color: #202124;
                border: 1px solid #DADCE0;
            }

                .google-btn:hover {
                    background: #F7F7F7;
                }

            .back-btn {
                display: block;
                width: 100%;
                padding: 14px;
                margin-top: 12px;
                border-radius: 9px;
                font-size: 0.95rem;
                font-weight: 700;
                text-align: center;
                text-decoration: none;
                background: transparent;
                color: var(--text-secondary);
                border: 1px solid var(--border-subtle);
            }

            .footer {
                text-align: center;
                color: var(--text-secondary);
                font-size: 0.75rem;
                line-height: 1.5;
                margin-top: 18px;
            }

            @@media (max-width: 850px) {
                .page {
                    grid-template-columns: 1fr;
                }

                .left {
                    border-right: none;
                    border-bottom: 1px solid var(--border-subtle);
                    padding: 40px 25px;
                }
            }
    </style>
</head>
<body>
    <div class="page">
        <!-- LEFT PANEL -->
        <section class="left">

            <div class="brand">
                <img src="~/images/logo.png" alt="Axert University">
                <div>
                    <div class="brand-title">Axert University</div>
                    <div class="brand-subtitle">Learning Management System</div>
                </div>
            </div>

            <div class="announcement-section">
                <div class="announcement-title">Announcement</div>
                <div class="announcement-card">
                    <p><strong>Welcome to the Fall Semester!</strong></p>
                    <p>We are thrilled to welcome both new and returning students to Axert University. Please review the important updates below to ensure a smooth start to your academic journey.</p>

                    <p><strong>Important Semester Dates:</strong></p>
                    <ul>
                        <li>Classes Begin: Monday, September 1, 2026</li>
                        <li>Add/Drop Deadline: Friday, September 15, 2026</li>
                    </ul>

                    <p><strong>Library Operating Hours:</strong></p>
                    <ul>
                        <li>Mon - Fri: 7:00 AM - 10:00 PM</li>
                        <li>Sat - Sun: 9:00 AM - 8:00 PM</li>
                    </ul>

                    <p><strong>Campus Reminder:</strong> All students are required to wear their university ID clearly visible at all times while inside campus facilities.</p>
                </div>
            </div>

        </section>

        <!-- RIGHT PANEL -->
        <main class="right">
            <div class="card">
                <h1>Student Enrollment</h1>
                <p class="subtitle">Create your student enrollment application with Google.</p>

                <div class="notice">
                    <strong>Google verification</strong>
                    <span>
                        AxertLMS never receives your Google password.
                        Google handles the sign-in and returns a verified
                        account identity to the application.
                    </span>
                </div>

                <a href="@Url.Action("GoogleRegister", "Account")" class="google-btn">
                    Continue with Google
                </a>

                <a href="@Url.Action("Login", "Account")" class="back-btn">
                    Back to Sign In
                </a>

                <div class="footer">
                    Your enrollment remains pending until the Registrar approves your application.
                </div>
            </div>
        </main>
    </div>
</body>
</html>