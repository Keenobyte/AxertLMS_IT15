@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model AxertLMS.Models.StudentRegistrationViewModel
@{
    Layout = null;
    ViewData["Title"] = "Student Enrollment";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Enrollment - AXERT LMS</title>
    <style>
            :root {
                --bg-main: #1A1A1A;
                --bg-card: #121212;
                --bg-card-light: #1E1E1E;
                --text-primary: #FFFFFF;
                --text-secondary: #9CA3AF;
                --border-subtle: #2D3748;
                --navy-light: #0B1F3A;
                --navy-dark: #020C1B;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                background: var(--bg-main);
                color: var(--text-primary);
                font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            }

            .page {
                min-height: 100vh;
                display: grid;
                grid-template-columns: 1fr 1fr;
            }

            .left {
                padding: 60px;
                background: var(--bg-card);
                border-right: 1px solid var(--border-subtle);
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            /* Restored Brand Component */
            .brand {
                display: flex;
                gap: 20px;
                align-items: center;
                padding: 25px;
                border: 1px solid var(--border-subtle);
                border-left: 4px solid var(--navy-light);
                border-radius: 12px;
                background: var(--bg-main);
                max-width: 620px;
                width: 100%;
                margin: 0 auto 40px auto;
            }

                .brand img {
                    width: 75px;
                    height: auto;
                    display: block;
                }

            .brand-title {
                font-size: 1.8rem;
                font-weight: 800;
                color: var(--text-primary);
            }

            .brand-subtitle {
                color: var(--text-secondary);
                margin-top: 5px;
                font-size: 0.95rem;
            }

            /* Announcement Component */
            .announcement-section {
                max-width: 620px;
                width: 100%;
                margin: 0 auto;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .announcement-title {
                color: var(--text-secondary);
                text-transform: uppercase;
                font-size: 0.85rem;
                letter-spacing: 1px;
                margin-bottom: 15px;
                font-weight: 600;
            }

            .announcement-card {
                background: var(--bg-card-light);
                padding: 35px;
                border-radius: 8px;
                border: 1px solid var(--border-subtle);
                box-shadow: 0 8px 16px rgba(0,0,0,0.2);
            }

                .announcement-card p {
                    color: var(--text-secondary);
                    line-height: 1.6;
                    font-size: 0.95rem;
                    margin-bottom: 12px;
                }

                .announcement-card strong {
                    color: var(--text-primary);
                }

                .announcement-card ul {
                    padding-left: 20px;
                    margin-top: 10px;
                    margin-bottom: 15px;
                }

                .announcement-card li {
                    color: var(--text-secondary);
                    line-height: 1.6;
                    font-size: 0.95rem;
                    margin-bottom: 8px;
                }

            .right {
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px;
            }

            .card {
                width: 100%;
                max-width: 470px;
                background: var(--bg-card);
                border: 1px solid var(--border-subtle);
                border-radius: 16px;
                padding: 42px;
                box-shadow: 0 12px 30px rgba(0,0,0,0.4);
            }

            h1 {
                text-align: center;
                margin: 0;
                font-size: 1.8rem;
            }

            .subtitle {
                text-align: center;
                color: var(--text-secondary);
                font-size: 0.9rem;
                line-height: 1.5;
                margin-bottom: 25px;
            }

            .error-message,
            .field-validation-error {
                color: #FCA5A5;
                font-size: 0.85rem;
            }

            .error-message {
                padding: 12px;
                border: 1px solid rgba(239, 68, 68, 0.35);
                border-radius: 8px;
                background: rgba(239, 68, 68, 0.08);
                margin-bottom: 18px;
            }

            .registration-form {
                display: grid;
                gap: 14px;
            }

            .name-fields {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }

            .field {
                display: grid;
                gap: 7px;
            }

            .field label {
                color: var(--text-secondary);
                font-size: 0.85rem;
                font-weight: 600;
            }

            .field input {
                width: 100%;
                padding: 12px;
                border: 1px solid var(--border-subtle);
                border-radius: 8px;
                background: var(--bg-card-light);
                color: var(--text-primary);
                font: inherit;
            }

            .field input:focus {
                outline: 2px solid #2563EB;
                outline-offset: 1px;
            }

            .registration-btn {
                width: 100%;
                padding: 14px;
                border: 1px solid #1D4ED8;
                border-radius: 9px;
                background: linear-gradient(to right, var(--navy-light), var(--navy-dark));
                color: var(--text-primary);
                font-size: 0.95rem;
                font-weight: 700;
                cursor: pointer;
            }

            .registration-btn:hover {
                border-color: #3B82F6;
            }

            .back-btn {
                display: block;
                width: 100%;
                padding: 14px;
                margin-top: 12px;
                border-radius: 9px;
                font-size: 0.95rem;
                font-weight: 700;
                text-align: center;
                text-decoration: none;
                background: transparent;
                color: var(--text-secondary);
                border: 1px solid var(--border-subtle);
            }

            .footer {
                text-align: center;
                color: var(--text-secondary);
                font-size: 0.75rem;
                line-height: 1.5;
                margin-top: 18px;
            }

            @@media (max-width: 850px) {
                .page {
                    grid-template-columns: 1fr;
                }

                .left {
                    border-right: none;
                    border-bottom: 1px solid var(--border-subtle);
                    padding: 40px 25px;
                }
            }
    </style>
</head>
<body>
    <div class="page">
        <!-- LEFT PANEL -->
        <section class="left">

            <div class="brand">
                <img src="~/images/logo.png" alt="Axert University">
                <div>
                    <div class="brand-title">Axert University</div>
                    <div class="brand-subtitle">Learning Management System</div>
                </div>
            </div>

            <div class="announcement-section">
                <div class="announcement-title">Announcement</div>
                <div class="announcement-card">
                    <p><strong>Welcome to the Fall Semester!</strong></p>
                    <p>We are thrilled to welcome both new and returning students to Axert University. Please review the important updates below to ensure a smooth start to your academic journey.</p>

                    <p><strong>Important Semester Dates:</strong></p>
                    <ul>
                        <li>Classes Begin: Monday, September 1, 2026</li>
                        <li>Add/Drop Deadline: Friday, September 15, 2026</li>
                    </ul>

                    <p><strong>Library Operating Hours:</strong></p>
                    <ul>
                        <li>Mon - Fri: 7:00 AM - 10:00 PM</li>
                        <li>Sat - Sun: 9:00 AM - 8:00 PM</li>
                    </ul>

                    <p><strong>Campus Reminder:</strong> All students are required to wear their university ID clearly visible at all times while inside campus facilities.</p>
                </div>
            </div>

        </section>

        <!-- RIGHT PANEL -->
        <main class="right">
            <div class="card">
                <h1>Student Enrollment</h1>
                <p class="subtitle">Apply using your email address and password.</p>

                @if (ViewBag.Error != null)
                {
                    <div class="error-message" role="alert">@ViewBag.Error</div>
                }

                <form asp-controller="Account" asp-action="Register" method="post" class="registration-form">
                    @Html.AntiForgeryToken()

                    <div class="name-fields">
                        <div class="field">
                            <label asp-for="FirstName"></label>
                            <input asp-for="FirstName" autocomplete="given-name" required>
                            <span asp-validation-for="FirstName" class="field-validation-error"></span>
                        </div>
                        <div class="field">
                            <label asp-for="LastName"></label>
                            <input asp-for="LastName" autocomplete="family-name" required>
                            <span asp-validation-for="LastName" class="field-validation-error"></span>
                        </div>
                    </div>

                    <div class="field">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" type="email" autocomplete="email" required>
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" autocomplete="new-password" required>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="ConfirmPassword"></label>
                        <input asp-for="ConfirmPassword" autocomplete="new-password" required>
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>

                    <button type="submit" class="registration-btn">Submit Manual Application</button>
                </form>

                <a href="@Url.Action("Login", "Account")" class="back-btn">
                    Back to Sign In
                </a>

                <div class="footer">
                    Applications remain pending until the Registrar approves them.
                    Approved accounts can sign in with their email and password.
                </div>
            </div>
        </main>
    </div>
</body>
</html>