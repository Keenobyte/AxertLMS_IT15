@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model AxertLMS.Models.GoogleCalendarPageViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Google Calendar";
}

<style>

    :root {
        --bg-main: #1A1A1A;
        --bg-card: #121212;
        --text-primary: #FFFFFF;
        --text-secondary: #9CA3AF;
        --border-subtle: #2D3748;
        --navy-light: #0B1F3A;
        --navy-dark: #020C1B;
        --success: #10B981;
        --danger: #EF4444;
    }

    .calendar-wrapper {
        padding: 2rem;
        color: var(--text-primary);
    }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 2rem;
    }

        .calendar-header h1 {
            margin: 0;
            font-size: 2rem;
        }

        .calendar-header p {
            color: var(--text-secondary);
            margin-top: 7px;
        }

    .submit-button {
        background: linear-gradient( 135deg, var(--navy-light), var(--navy-dark) );
        color: var(--text-primary);
        border: 1px solid var(--border-subtle);
        padding: 12px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 700;
        display: inline-block;
    }

    .connected {
        color: var(--success);
        font-size: 0.85rem;
        margin-top: 5px;
    }

    .error,
    .success {
        padding: 12px 15px;
        border-radius: 8px;
        margin-bottom: 18px;
    }

    .error {
        color: var(--danger);
        background: rgba(239,68,68,0.08);
        border: 1px solid rgba(239,68,68,0.2);
    }

    .success {
        color: var(--success);
        background: rgba(16,185,129,0.08);
        border: 1px solid rgba(16,185,129,0.2);
    }

    .grid {
        display: grid;
        grid-template-columns: minmax(0, 1.3fr) minmax(320px, 0.7fr);
        gap: 1.5rem;
    }

    .panel {
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: 10px;
        padding: 1.5rem;
    }

        .panel h2 {
            margin-top: 0;
            font-size: 1.2rem;
        }

    .event {
        padding: 15px;
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        background: rgba(255,255,255,0.02);
        margin-bottom: 10px;
    }

        .event:last-child {
            margin-bottom: 0;
        }

    .event-title {
        font-weight: 700;
        margin-bottom: 5px;
    }

    .event-time {
        color: var(--text-secondary);
        font-size: 0.85rem;
        line-height: 1.5;
    }

    .event-description {
        color: var(--text-secondary);
        margin-top: 8px;
        font-size: 0.85rem;
    }

    .event-link {
        color: #93C5FD;
        text-decoration: none;
        font-size: 0.8rem;
        display: inline-block;
        margin-top: 8px;
    }

    label {
        display: block;
        margin-bottom: 6px;
        color: var(--text-secondary);
        font-size: 0.82rem;
        font-weight: 700;
    }

    .field {
        margin-bottom: 15px;
    }

    input,
    textarea {
        width: 100%;
        box-sizing: border-box;
        padding: 12px;
        border: 1px solid var(--border-subtle);
        background: var(--bg-main);
        color: var(--text-primary);
        border-radius: 7px;
    }

    textarea {
        resize: vertical;
        min-height: 90px;
    }

        input:focus,
        textarea:focus {
            outline: none;
            border-color: #4A5568;
        }

    .submit-button {
        width: 100%;
        cursor: pointer;
    }

    .empty {
        text-align: center;
        padding: 30px 10px;
        color: var(--text-secondary);
    }

    @@media (max-width: 900px) {

        .grid {
            grid-template-columns: 1fr;
        }

        .calendar-header {
            flex-direction: column;
        }
    }

</style>

<div class="calendar-wrapper">

    <div class="calendar-header">

        <div>

            <h1>
                Google Calendar
            </h1>

            <p>
                View upcoming Google Calendar events and create
                new events directly from AxertLMS.
            </p>

            @if (Model.IsConnected)
            {
                <div class="connected">

                    Connected:
                    @Model.GoogleEmail

                </div>
            }

        </div>



    </div>

    @if (TempData["Error"] != null)
    {
        <div class="error">
            @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["GoogleConnected"] != null)
    {
        <div class="success">
            @TempData["GoogleConnected"]
        </div>
    }

    <div class="grid">

        <section class="panel">

            <h2>
                Upcoming Events
            </h2>

            @if (!Model.IsConnected)
            {
                <div class="empty">

                    <p>
                        Google Calendar is not connected to this AxertLMS account.
                    </p>

                    <p>
                        Calendar permission is requested automatically when you
                        sign in or register with Google.
                    </p>

                    <p>
                        Sign out and use Sign in with Google to grant Calendar access.
                    </p>

                </div>
            }
            else if (Model.Events.Count == 0)
            {
                <div class="empty">

                    No upcoming Google Calendar events were found.

                </div>
            }
            else
            {
                foreach (var item in Model.Events)
                {
                    <article class="event">

                        <div class="event-title">
                            @item.Title
                        </div>

                        @if (item.IsAllDay)
                        {
                            <div class="event-time">

                                @item.AllDayStartDate

                                <br>

                                All day

                            </div>
                        }
                        else
                        {
                            <div class="event-time">

                                @item.Start?.ToString("MMM dd, yyyy h:mm tt")

                                —

                                @item.End?.ToString("h:mm tt")

                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            item.Location))
                        {
                            <div class="event-description">

                                Location:
                                @item.Location

                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            item.Description))
                        {
                            <div class="event-description">

                                @item.Description

                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            item.HtmlLink))
                        {
                            <a href="@item.HtmlLink"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="event-link">

                                Open in Google Calendar

                            </a>
                        }

                    </article>
                }
            }

        </section>

        <section class="panel">

            <h2>
                Create LMS / Calendar Event
            </h2>

            @if (!Model.IsConnected)
            {
                <div class="empty">

                    Google Calendar permission is not available.

                    <br><br>

                    Sign in with Google to grant Calendar access, then return here
                    to create class schedules or other LMS events.

                </div>
            }
            else
            {
                var form =
                    ViewBag.Form
                    as AxertLMS.Models.CreateGoogleEventViewModel;

                <form asp-controller="GoogleCalendar"
                      asp-action="CreateEvent"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="field">

                        <label>
                            Event title
                        </label>

                        <input type="text"
                               name="Title"
                               value="@form?.Title"
                               maxlength="200"
                               required>

                    </div>

                    <div class="field">

                        <label>
                            Description
                        </label>

                        <textarea name="Description"
                                  maxlength="5000">@form?.Description</textarea>

                    </div>

                    <div class="field">

                        <label>
                            Location
                        </label>

                        <input type="text"
                               name="Location"
                               value="@form?.Location"
                               maxlength="500">

                    </div>

                    <div class="field">

                        <label>
                            Start
                        </label>

                        <input type="datetime-local"
                               name="Start"
                               value="@(form?.Start.ToString("yyyy-MM-ddTHH:mm"))"
                               required>

                    </div>

                    <div class="field">

                        <label>
                            End
                        </label>

                        <input type="datetime-local"
                               name="End"
                               value="@(form?.End.ToString("yyyy-MM-ddTHH:mm"))"
                               required>

                    </div>

                    <button type="submit"
                            class="submit-button">

                        Create Google Calendar Event

                    </button>

                </form>
            }

        </section>

    </div>

</div>