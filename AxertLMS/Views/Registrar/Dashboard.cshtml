@model IEnumerable<AxertLMS.Models.Student>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Registrar Dashboard";
}

<style>
    :root {
        --canvas: #17191d;
        --card: #20242a;
        --card-soft: #1b1e23;
        --text: #f7f8fa;
        --muted: #9da6b5;
        --line: #363d47;
        --navy: #173b69;
        --green: #34d399;
        --amber: #fbbf24;
        --red: #fb7185;
    }

    .registrar-dashboard {
        color: var(--text);
        max-width: 1440px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .eyebrow {
        color: #83b7ff;
        font-weight: 700;
        letter-spacing: .12em;
        font-size: .72rem;
        text-transform: uppercase;
        margin: 0 0 .55rem;
    }

    .page-header h1 {
        margin: 0;
        font-size: 2rem;
        letter-spacing: -.035em;
    }

    .page-header p {
        color: var(--muted);
        margin: .55rem 0 0;
    }

    .header-action {
        color: white;
        text-decoration: none;
        background: linear-gradient(135deg,#1f528e,#102b50);
        border: 1px solid #3d73ad;
        padding: .8rem 1rem;
        border-radius: 9px;
        font-weight: 700;
        white-space: nowrap;
    }

    .metric-grid {
        display: grid;
        grid-template-columns: repeat(5,minmax(0,1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .metric {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 1.25rem;
        min-height: 130px;
        color: var(--text);
    }

    .metric-label {
        color: var(--muted);
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .09em;
        text-transform: uppercase;
    }

    .metric-value {
        font-size: 2.15rem;
        font-weight: 800;
        letter-spacing: -.05em;
        margin: .72rem 0 .15rem;
    }

    .metric-note {
        color: var(--muted);
        font-size: .78rem;
    }

    .metric-toggle {
        font: inherit;
        text-align: left;
        cursor: pointer;
        transition: transform .18s ease,border-color .18s ease;
    }

        .metric-toggle:hover, .metric-toggle[aria-expanded="true"] {
            transform: translateY(-2px);
            border-color: #638fc2;
        }

        .metric-toggle .metric-value {
            color: var(--amber);
        }

    .panel {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 1.35rem;
    }

    .panel-title {
        margin: 0;
        font-size: 1.05rem;
    }

    .panel-subtitle {
        color: var(--muted);
        margin: .38rem 0 1.15rem;
        font-size: .9rem;
    }

    .message {
        border-radius: 10px;
        padding: 1rem 1.1rem;
        margin-bottom: 1.25rem;
        font-size: .92rem;
    }

    .message-success {
        border: 1px solid rgba(52,211,153,.35);
        color: #a7f3d0;
        background: rgba(52,211,153,.08);
    }

    .message-error {
        border: 1px solid rgba(251,113,133,.35);
        color: #fecdd3;
        background: rgba(251,113,133,.08);
    }

    .approval-panel {
        margin-bottom: 1.5rem;
        overflow: hidden;
    }

    .queue {
        display: grid;
        gap: .65rem;
    }

    .queue-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem;
        background: var(--card-soft);
        border: 1px solid var(--line);
        border-radius: 9px;
    }

    .queue-position {
        display: inline-grid;
        place-items: center;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: rgba(251,191,36,.13);
        color: var(--amber);
        font-size: .78rem;
        font-weight: 800;
        margin-right: .65rem;
    }

    .student-name {
        font-weight: 700;
    }

    .student-email {
        display: block;
        color: var(--muted);
        font-size: .85rem;
        margin-top: .2rem;
    }

    .status {
        color: var(--amber);
        font-weight: 700;
        font-size: .76rem;
        margin-left: .4rem;
    }

    .approve {
        display: inline-block;
        background: rgba(52,211,153,.12);
        border: 1px solid rgba(52,211,153,.38);
        color: #a7f3d0;
        border-radius: 8px;
        padding: .62rem .8rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        white-space: nowrap;
    }

        .approve:hover {
            background: rgba(52,211,153,.2);
        }

    .content-grid {
        display: grid;
        grid-template-columns: minmax(0,1.75fr) minmax(280px,.8fr);
        gap: 1.5rem;
    }

    .table-wrap {
        overflow: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 600px;
    }

    th {
        text-align: left;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .08em;
        font-size: .7rem;
        padding: 0 0 .9rem;
    }

    td {
        border-top: 1px solid var(--line);
        padding: 1rem 0;
    }

    .active {
        color: var(--green);
        font-weight: 700;
        font-size: .86rem;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: .95rem 0;
        border-bottom: 1px solid var(--line);
        color: var(--muted);
    }

        .summary-row strong {
            color: var(--text);
        }

        .summary-row:last-of-type {
            border-bottom: none;
        }

    .summary-note {
        color: var(--muted);
        line-height: 1.55;
        font-size: .87rem;
        padding: 1rem;
        margin-top: 1.1rem;
        background: var(--card-soft);
        border-radius: 8px;
    }

    @@media (max-width:1150px) {
        .metric-grid {
            grid-template-columns: repeat(3,minmax(0,1fr));
        }
    }

    @@media (max-width:800px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .content-grid {
            grid-template-columns: 1fr;
        }

        .metric-grid {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }
    }

    @@media (max-width:520px) {
        .metric-grid {
            grid-template-columns: 1fr;
        }

        .queue-row {
            align-items: flex-start;
            flex-direction: column;
        }

        .approve {
            width: 100%;
        }
    }
</style>

<main class="registrar-dashboard">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="message message-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="message message-error">@TempData["ErrorMessage"]</div>
    }

    <header class="page-header">
        <div>
            <p class="eyebrow">Registrar workspace</p>
            <h1>Enrollment overview</h1>
            <p>Review applications, approve students, and complete academic placement.</p>
        </div>
        <a class="header-action" asp-action="RegisterStudent">Complete student enrollment</a>
    </header>

    <section class="metric-grid" aria-label="Enrollment metrics">
        <div class="metric"><div class="metric-label">Enrolled students</div><div class="metric-value">@ViewBag.TotalStudents</div><div class="metric-note">Academic records created</div></div>
        <button type="button" id="pendingToggle" class="metric metric-toggle" aria-controls="pendingPanel" aria-expanded="false" onclick="togglePendingStudents()"><div class="metric-label">Pending approval</div><div class="metric-value">@ViewBag.PendingStudents</div><div class="metric-note">Click to review the queue</div></button>
        <div class="metric"><div class="metric-label">Faculty members</div><div class="metric-value">@ViewBag.TotalTeachers</div><div class="metric-note">Active teaching staff</div></div>
        <div class="metric"><div class="metric-label">Academic sections</div><div class="metric-value">@ViewBag.TotalSections</div><div class="metric-note">Available placements</div></div>
        <div class="metric"><div class="metric-label">Course subjects</div><div class="metric-value">@ViewBag.TotalSubjects</div><div class="metric-note">Curriculum subjects</div></div>
    </section>

    <section id="pendingPanel" class="panel approval-panel" hidden>
        <h2 class="panel-title">Pending application queue</h2>
        <p class="panel-subtitle">Applications are ordered first-come, first-served.</p>
        @if (ViewBag.PendingApplications != null && ViewBag.PendingApplications.Count > 0)
        {
            var position = 1;
            <div class="queue">
                @foreach (var applicant in ViewBag.PendingApplications)
                {
                    <div class="queue-row">
                        <div><span class="queue-position">@position</span><span class="student-name">@applicant.l_name, @applicant.f_name <span class="status">PENDING</span></span><span class="student-email">@applicant.email</span></div>
                        <a class="approve" asp-action="RegisterStudent">Review &amp; assign section</a>
                    </div>
                    position++;
                }
            </div>
        }
        else
        {

            <p class="panel-subtitle">There are no applications waiting for approval.</p>
        }
    </section>

    <section class="content-grid">
        <article class="panel">
            <h2 class="panel-title">Recent student registrations</h2>
            <p class="panel-subtitle">Latest students with an academic section assignment.</p>
            @if (Model != null && Model.Any())
            {
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Student number</th><th>Student</th><th>Section</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var student in Model)
                            {
                                <tr><td>@student.student_number</td><td>@student.User?.l_name, @student.User?.f_name</td><td>@student.Section?.section_name <span style="color:var(--muted)">(@(student.Section?.Strand?.strand_code ?? "N/A"))</span></td><td><span class="active">Active</span></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {

                <p class="panel-subtitle">No student records have been created yet.</p>
            }
        </article>
        <aside class="panel">
            <h2 class="panel-title">Enrollment summary</h2>
            <p class="panel-subtitle">Current registrar workload.</p>
            <div class="summary-row"><span>Pending approvals</span><strong>@ViewBag.PendingStudents</strong></div>
            <div class="summary-row"><span>Registered students</span><strong>@ViewBag.TotalStudents</strong></div>
            <div class="summary-row"><span>Faculty members</span><strong>@ViewBag.TotalTeachers</strong></div>
            <div class="summary-row"><span>Academic sections</span><strong>@ViewBag.TotalSections</strong></div>
            <div class="summary-row"><span>Course subjects</span><strong>@ViewBag.TotalSubjects</strong></div>
            <div class="summary-note">Use <strong>Complete student enrollment</strong> to approve pending applications or finish profiles for active students, assign a section, and generate a student number.</div>
        </aside>
    </section>
</main>

<script>
    function togglePendingStudents() {
        const panel = document.getElementById('pendingPanel');
        const button = document.getElementById('pendingToggle');
        const willOpen = panel.hidden;
        panel.hidden = !willOpen;
        button.setAttribute('aria-expanded', willOpen.toString());
    }
</script>
