@model IEnumerable<AxertLMS.Models.Section>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Manage Sections";
}

<style>
    :root {
        --surface: #20242a;
        --surface-soft: #1b1e23;
        --text: #f7f8fa;
        --muted: #9da6b5;
        --line: #363d47;
        --blue: #4f93e6;
        --green: #34d399;
        --red: #fb7185;
    }

    .sections-page {
        max-width: 1180px;
        margin: 0 auto;
        color: var(--text);
    }

    .sections-header {
        margin-bottom: 1.8rem;
    }

    .eyebrow {
        color: #83b7ff;
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .12em;
        font-weight: 800;
        margin: 0 0 .5rem;
    }

    .sections-header h1 {
        margin: 0;
        font-size: 2rem;
        letter-spacing: -.035em;
    }

    .sections-header > p:last-child {
        color: var(--muted);
        margin: .55rem 0 0;
    }

    .sections-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(300px, .9fr);
        gap: 1rem;
        align-items: start;
    }

    .card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 1.5rem;
    }

    .card-heading {
        margin: 0;
        font-size: 1.05rem;
    }

    .card-copy {
        color: var(--muted);
        margin: .38rem 0 1.25rem;
        font-size: .9rem;
        line-height: 1.5;
    }

    .table-wrap {
        overflow-x: auto;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 620px;
    }

        .data-table th {
            text-align: left;
            color: #c9d1dc;
            font-size: .72rem;
            font-weight: 800;
            letter-spacing: .08em;
            padding: .75rem .85rem;
            border-bottom: 1px solid var(--line);
            white-space: nowrap;
        }

        .data-table td {
            padding: .95rem .85rem;
            border-bottom: 1px solid var(--line);
            color: var(--text);
            font-size: .9rem;
        }

        .data-table tbody tr:last-child td {
            border-bottom: none;
        }

        .data-table tbody tr:hover {
            background: rgba(255,255,255,.025);
        }

    .section-id {
        color: #9fc8ff;
        font-weight: 700;
    }

    .strand-badge,
    .year-badge {
        display: inline-flex;
        align-items: center;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: .28rem .6rem;
        font-size: .74rem;
        font-weight: 700;
    }

    .strand-badge {
        color: #b9d9ff;
        background: rgba(79,147,230,.08);
    }

    .year-badge {
        color: #cbd5e1;
        background: rgba(255,255,255,.04);
    }

    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--muted);
    }

        .empty-state i {
            opacity: .5;
            margin-bottom: .9rem;
        }

    .field {
        margin-bottom: 1.2rem;
    }

        .field:last-of-type {
            margin-bottom: 1.35rem;
        }

    label {
        display: block;
        color: #c9d1dc;
        font-size: .76rem;
        font-weight: 800;
        letter-spacing: .08em;
        margin-bottom: .5rem;
    }

    input,
    select {
        width: 100%;
        box-sizing: border-box;
        background: #17191d !important;
        border: 1px solid var(--line) !important;
        color: var(--text) !important;
        border-radius: 8px;
        padding: .83rem .9rem;
        font: inherit;
    }

        input::placeholder {
            color: #737d8d;
        }

        input:focus,
        select:focus {
            outline: none !important;
            border-color: var(--blue) !important;
            box-shadow: 0 0 0 3px rgba(79,147,230,.14) !important;
        }

        select option {
            background: #17191d;
            color: var(--text);
        }

    .help {
        color: var(--muted);
        font-size: .82rem;
        margin: .45rem 0 0;
        line-height: 1.45;
    }

    .submit {
        width: 100%;
        padding: .95rem 1rem;
        border: 1px solid #47a886;
        color: #fff;
        background: linear-gradient(135deg,#167454,#0e513d);
        border-radius: 8px;
        font: inherit;
        font-weight: 800;
        cursor: pointer;
        transition: filter .2s ease;
    }

        .submit:hover {
            filter: brightness(1.12);
        }

    .message {
        border-radius: 9px;
        padding: .9rem 1rem;
        margin-bottom: 1rem;
        font-size: .9rem;
    }

    .success {
        color: #a7f3d0;
        background: rgba(52,211,153,.1);
        border: 1px solid rgba(52,211,153,.3);
    }

    .error {
        color: #fecdd3;
        background: rgba(251,113,133,.1);
        border: 1px solid rgba(251,113,133,.3);
    }

    .info-note {
        display: flex;
        align-items: flex-start;
        gap: .65rem;
        color: var(--muted);
        background: var(--surface-soft);
        border-radius: 8px;
        padding: .8rem .9rem;
        font-size: .84rem;
        line-height: 1.45;
        margin-bottom: 1.25rem;
    }

        .info-note i {
            color: #83b7ff;
            margin-top: .1rem;
        }

    @@media (max-width: 860px) {
        .sections-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .sections-page {
            width: 100%;
        }

        .sections-header h1 {
            font-size: 1.7rem;
        }

        .card {
            padding: 1.1rem;
        }
    }
</style>

<main class="sections-page">
    <header class="sections-header">
        <p class="eyebrow">Registrar workspace</p>
        <h1>Manage academic sections</h1>
        <p>Create and review the active sections available for student placement.</p>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="message success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="message error">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="sections-grid">

        <section class="card">
            <h2 class="card-heading">Active academic sections</h2>
            <p class="card-copy">
                Review the sections currently configured in the system. These sections can be assigned during student enrollment.
            </p>

            <div class="table-wrap">
                @if (Model != null && Model.Any())
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>SECTION ID</th>
                                <th>NAME</th>
                                <th>STRAND</th>
                                <th>YEAR LEVEL</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sec in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="section-id">#@sec.section_id</span>
                                    </td>
                                    <td>@sec.section_name</td>
                                    <td>
                                        <span class="strand-badge">@(sec.Strand?.strand_code ?? "N/A")</span>
                                    </td>
                                    <td>
                                        <span class="year-badge">Grade @sec.year_lvl</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fa-solid fa-folder-open fa-3x"></i>
                        <p>No academic sections have been created yet.</p>
                    </div>
                }
            </div>
        </section>

        <section class="card">
            <h2 class="card-heading">Create new section</h2>
            <p class="card-copy">
                Add a new academic section that can later be assigned to approved students.
            </p>

            <div class="info-note">
                <i class="fa-solid fa-circle-info"></i>
                <span>Use a clear section name that identifies its year level and class grouping.</span>
            </div>

            <form method="post" action="/Registrar/AddSection">
                @Html.AntiForgeryToken()

                <div class="field">
                    <label for="section_name">SECTION NAME</label>
                    <input id="section_name"
                           type="text"
                           name="section_name"
                           placeholder="e.g. 12-Newton"
                           required />
                    <p class="help">Example: 12-Newton, 11-Einstein, or another official class name.</p>
                </div>

                <div class="field">
                    <label for="strand">STRAND</label>
                    <select id="strand" name="strand" required>
                        <option value="">Select a strand</option>
                        <option value="STEM">STEM</option>
                        <option value="HUMSS">HUMSS</option>
                        <option value="ABM">ABM</option>
                    </select>
                </div>

                <div class="field">
                    <label for="year_lvl">YEAR LEVEL</label>
                    <select id="year_lvl" name="year_lvl" required>
                        <option value="">Select year level</option>
                        <option value="11">Grade 11</option>
                        <option value="12">Grade 12</option>
                    </select>
                </div>

                <button type="submit" class="submit">
                    <i class="fa-solid fa-plus me-2"></i>
                    Add Section
                </button>
            </form>
        </section>

    </div>
</main>