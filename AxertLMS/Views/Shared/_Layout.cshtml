@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var role = HttpContextAccessor.HttpContext?.Session.GetString("UserRole");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AxertLMS</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            /* Modern Dark Mode Design System Constants */
            :root {
                --bg-main: #161719;
                --bg-sidebar: #0F1012;
                --text-primary: #FFFFFF;
                --text-secondary: #8E94A0;
                --text-muted: #5C616C;
                --accent-glow: rgba(255, 255, 255, 0.03);
                --border-subtle: rgba(255, 255, 255, 0.06);
                --sidebar-width: 235px;
            }

            body {
                margin: 0;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                background-color: var(--bg-main);
                color: var(--text-primary);
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
            }

            .app-container {
                display: flex;
                min-height: 100vh;
            }

            /* PREMIUM SIDEBAR ARCHITECTURE */
            .sidebar {
                width: var(--sidebar-width);
                background: var(--bg-sidebar);
                display: flex;
                flex-direction: column;
                border-right: 1px solid var(--border-subtle);
                position: fixed;
                top: 0;
                left: 0;
                height: 100vh;
                z-index: 100;
                box-sizing: border-box;
            }

            /* LOGO BOX - Proportional spacing adjustments */
            .sidebar-logo-container {
                padding-top: 40px;
                padding-right: 60px;
                padding-bottom: 20px;
                padding-left: 50px;
                display: flex;
                justify-content: flex-start;
                align-items: center;
                border-bottom: 1px solid var(--border-subtle);
            }

            .sidebar-logo {
                width: 133px;
                height: auto;
                object-fit: contain;
                filter: drop-shadow(0px 4px 8px rgba(0, 0, 0, 0.3));
            }

            /* NAVIGATION INTERFACE */
            .nav-scroller {
                flex: 1;
                overflow-y: auto;
                padding: 20px 0;
            }

                /* Scrollbar styling for a completely premium look */
                .nav-scroller::-webkit-scrollbar {
                    width: 5px;
                }

                .nav-scroller::-webkit-scrollbar-thumb {
                    background: rgba(255, 255, 255, 0.1);
                    border-radius: 4px;
                }

            .nav-group {
                padding: 24px 28px 8px;
                font-size: 0.72rem;
                text-transform: uppercase;
                color: var(--text-muted);
                letter-spacing: 1.5px;
                font-weight: 700;
            }

            .nav-link {
                display: flex;
                align-items: center;
                padding: 13px 28px;
                color: var(--text-secondary);
                text-decoration: none;
                font-size: 0.92rem;
                font-weight: 500;
                border-left: 3px solid transparent;
                transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            }

                .nav-link:hover {
                    background: var(--accent-glow);
                    color: var(--text-primary);
                    border-left-color: var(--text-secondary);
                    padding-left: 32px; /* Smooth elegant shift forward */
                }

            .nav-icon {
                margin-right: 14px;
                font-size: 1.05rem;
                width: 20px; /* Fixed footprint keeps column layout completely aligned */
                text-align: center;
                opacity: 0.8;
                transition: transform 0.2s ease;
            }

            .nav-link:hover .nav-icon {
                opacity: 1;
                transform: scale(1.05);
            }

            /* ACTIONS FOOTER */
            .sidebar-footer {
                padding: 15px 0 25px;
                border-top: 1px solid var(--border-subtle);
            }

            .nav-link.logout {
                color: #F87171;
            }

                .nav-link.logout:hover {
                    border-left-color: #EF4444;
                    color: #EF4444;
                    background: rgba(239, 68, 68, 0.03);
                }

            /* APP CANVAS VIEWPORT */
            .main-content {
                flex: 1;
                padding: 40px;
                margin-left: var(--sidebar-width);
                background-color: var(--bg-main);
                box-sizing: border-box;
                min-height: 100vh;
            }
    </style>
</head>
<body>
    <div class="app-container">
        @if (role != null)
        {
            <div class="sidebar">
                <div class="sidebar-logo-container">
                    <img src="~/images/logo.png" alt="LMS Logo" class="sidebar-logo" />
                </div>

                <div class="nav-scroller">
                    @if (role == "Student")
                    {
                        <div class="nav-group">Academic Portal</div>
                        <a href="/Student/Dashboard" class="nav-link"><i class="fa-solid fa-chart-pie nav-icon"></i> Dashboard</a>
                        <a href="/Student/Classrooms" class="nav-link"><i class="fa-solid fa-chalkboard-user nav-icon"></i> My Classrooms</a>
                        <a href="/Student/Calendar" class="nav-link"><i class="fa-solid fa-calendar-days nav-icon"></i> Calendar</a>
                        <a href="@Url.Action("Index", "GoogleCalendar")" class="nav-link">
                            <i class="fab fa-google nav-icon"></i> Google Calendar
                        </a>
                        <a href="/Student/Assignments" class="nav-link"><i class="fa-solid fa-file-signature nav-icon"></i> Assignments</a>
                        <a href="/Student/Announcements" class="nav-link"><i class="fa-solid fa-bullhorn nav-icon"></i> Announcements</a>

                    }
                    else if (role == "Teacher")
                    {
                        <div class="nav-group">Faculty Workspace</div>
                        <a href="/Teacher/Dashboard" class="nav-link"><i class="fa-solid fa-chart-pie nav-icon"></i> Dashboard</a>
                        <a href="/Teacher/MyClasses" class="nav-link"><i class="fa-solid fa-chalkboard nav-icon"></i> My Classes</a>
                        <a href="/Teacher/GradingCenter" class="nav-link"><i class="fa-solid fa-graduation-cap nav-icon"></i> Grading Center</a>
                    }
                    else if (role == "Registrar")
                    {
                        <div class="nav-group">Operations Overview</div>
                        <a href="/Registrar/Dashboard" class="nav-link"><i class="fa-solid fa-chart-pie nav-icon"></i> Dashboard</a>

                        <div class="nav-group">Administration</div>
                        <a href="/Registrar/RegisterStudent" class="nav-link"><i class="fa-solid fa-user-plus nav-icon"></i> Enroll Student</a>
                        <a href="/Registrar/RegisterTeacher" class="nav-link"><i class="fa-solid fa-user-tie nav-icon"></i> Add Faculty</a>
                        <a href="/Registrar/ManageSections" class="nav-link"><i class="fa-solid fa-layer-group nav-icon"></i> Manage Sections</a>
                        <a href="/Registrar/ManageSubjects" class="nav-link"><i class="fa-solid fa-book nav-icon"></i> Manage Ssubjects</a>
                        <a href="/Registrar/ManageCurriculum" class="nav-link"><i class="fa-solid fa-network-wired nav-icon"></i> Curriculum Map</a>
                        <a href="/Registrar/AssignFaculty" class="nav-link"><i class="fa-solid fa-chalkboard-user nav-icon"></i> Assign Faculty</a>
                    }
                    else if (role == "Admin")
                    {
                        <div class="nav-group">Management Core</div>
                        <a href="/Admin/Dashboard" class="nav-link"><i class="fa-solid fa-gauge-high nav-icon"></i> Overview</a>
                        <a href="/Admin/ManageUsers" class="nav-link"><i class="fa-solid fa-users-gear nav-icon"></i> Manage Users</a>
                    }
                    else if (role == "Super Admin")
                    {
                        <div class="nav-group">System Architecture</div>
                        <a href="/SuperAdmin/Dashboard" class="nav-link"><i class="fa-solid fa-heart-pulse nav-icon"></i> System Health</a>
                        <a href="/SuperAdmin/Database" class="nav-link"><i class="fa-solid fa-database nav-icon"></i> Raw Database</a>
                        <a href="/SuperAdmin/RoleManager" class="nav-link"><i class="fa-solid fa-shield-halved nav-icon"></i> Access Control</a>
                    }
                </div>

                <div class="sidebar-footer">
                    <a href="/Account/Login" class="nav-link logout"><i class="fa-solid fa-right-from-bracket nav-icon"></i> Logout</a>
                </div>
            </div>
        }

        <div class="main-content">
            @RenderBody()
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>