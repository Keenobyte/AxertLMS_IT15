@model AxertLMS.Models.ErrorViewModel
@{
    Layout = null;
    ViewData["Title"] = "Something went wrong";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>@ViewData["Title"] - AxertLMS</title>
    <style>
        :root {
            color-scheme: dark;
            font-family: "Segoe UI", system-ui, sans-serif;
            background: #111318;
            color: #f3f4f6;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 24px;
            box-sizing: border-box;
        }

        main {
            width: min(100%, 620px);
            padding: clamp(28px, 6vw, 48px);
            border: 1px solid #303642;
            border-radius: 16px;
            background: #191c22;
            box-sizing: border-box;
        }

        h1 {
            margin-top: 0;
            font-size: 2rem;
        }

        p {
            color: #b6becb;
            line-height: 1.65;
        }

        .request-id {
            overflow-wrap: anywhere;
            font-family: ui-monospace, Consolas, monospace;
            font-size: 0.9rem;
        }

        a {
            color: #9dc2ff;
        }
    </style>
</head>
<body>
    <main>
        <h1>We couldn't complete that request</h1>
        <p>An unexpected error occurred. Please try again. If the problem continues, contact the site administrator and provide the reference ID below.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p class="request-id">Reference ID: @Model.RequestId</p>
        }
        <p><a href="@Url.Action("Index", "Home")">Return to AxertLMS</a></p>
        <p><a href="mailto:kurtcandrejo@gmail.com">Contact support</a></p>
    </main>
</body>
</html>
