@model AxertLMS.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Determine Role Badge Color dynamically
    string roleBadgeColor = Model.Role switch
    {
        "Super Admin" => "var(--danger)",
        "Admin" => "var(--warning)",
        "Registrar" => "#8B5CF6", // Purple
        "Teacher" => "#3B82F6",   // Blue
        _ => "var(--success)"     // Student (Green)
    };
}

<style>
    :root {
        --bg-main: #1A1A1A;
        --bg-card: #121212;
        --text-primary: #FFFFFF;
        --text-secondary: #9CA3AF;
        --border-subtle: #2D3748;
        --danger: #EF4444;
        --warning: #F59E0B;
        --success: #10B981;
    }

    .profile-container {
        display: grid;
        grid-template-columns: 1fr 2fr;
        gap: 24px;
        color: var(--text-primary);
        align-items: start;
    }

    .panel {
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.2);
    }

    /* Left Card: Profile ID */
    .id-card {
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: var(--border-subtle);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        margin-bottom: 15px;
    }

    .role-badge {
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: bold;
        color: white;
        margin-top: 10px;
        display: inline-block;
    }

    .status-dot {
        height: 10px;
        width: 10px;
        background-color: var(--success);
        border-radius: 50%;
        display: inline-block;
        margin-right: 5px;
    }

    /* Right Side Details */
    .detail-group {
        margin-bottom: 20px;
    }

        .detail-group label {
            color: var(--text-secondary);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: block;
            margin-bottom: 5px;
        }

        .detail-group p {
            font-size: 1.1rem;
            margin: 0;
            font-weight: 500;
        }

    .divider {
        height: 1px;
        background: var(--border-subtle);
        margin: 20px 0;
    }
</style>

<div class="header-section" style="margin-bottom: 24px;">
    <h1 style="color: var(--text-primary); margin:0; font-size: 2rem;">User Profile</h1>
</div>

<div class="profile-container">
    <div class="panel id-card">
        <div class="avatar">👤</div>
        <h2 style="margin: 0 0 5px 0;">@Model.FirstName @Model.LastName</h2>
        <div style="color: var(--text-secondary);">@Model.Email</div>

        <div class="role-badge" style="background-color: @roleBadgeColor;">
            @Model.Role
        </div>

        <div style="margin-top: 20px; font-size: 0.9rem;">
            <span class="status-dot" style="background-color: @(Model.Status == "Active" ? "var(--success)" : "var(--danger)")"></span>
            @Model.Status Account
        </div>
    </div>

    <div class="panel">
        <h3 style="margin-top: 0; border-bottom: 1px solid var(--border-subtle); padding-bottom: 10px;">Role Information</h3>

        @if (Model.Role == "Student")
        {
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div class="detail-group">
                    <label>Student Number</label>
                    <p>@Model.StudentNumber</p>
                </div>
                <div class="detail-group">
                    <label>Grade & Section</label>
                    <p>Grade @Model.YearLevel | @Model.SectionName</p>
                </div>
                <div class="detail-group">
                    <label>Academic Track</label>
                    <p>@Model.Strand</p>
                </div>
                <div class="detail-group">
                    <label>Active Enrollments</label>
                    <p>@Model.EnrolledClassesCount Classes</p>
                </div>
            </div>
        }
        else if (Model.Role == "Teacher")
        {
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div class="detail-group">
                    <label>Department Specialization</label>
                    <p>@Model.Specialization</p>
                </div>
                <div class="detail-group">
                    <label>Assigned Classrooms</label>
                    <p>@Model.HandledClassesCount Classes</p>
                </div>
            </div>
        }
        else
        {
            <div class="detail-group">
                <label>System Privileges</label>
                <p>
                    @if (Model.Role == "Registrar")
                    {
                        @:Authorized to manage student records, sections, and enrollments.
                    }
                    else if (Model.Role == "Admin")
                    {
                        @:Authorized to manage system users, curriculum, and global announcements.
                    }
                    else if (Model.Role == "Super Admin")
                    {
                        @:Full unrestricted system access.
                    }
                </p>
            </div>
        }

        <div class="divider"></div>

        <h3 style="margin-top: 0;">Account Security</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem;">To change your password or update your login credentials, please contact the IT Administrator or Registrar.</p>
    </div>
</div>